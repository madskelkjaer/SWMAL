\newread\tmp
%%% Counting Char %%%
\newcommand{\quickcharcount}[1]{%
  \immediate\write18{texcount -1 -sum -merge -char-only #1.tex > #1-chars.sum}%
  \openin\tmp=#1-chars.sum%
  \read\tmp to \thechar%
  \closein\tmp%
}
%%% Counting Words %%%
\newcommand{\quickwordcount}[1]{%
  \immediate\write18{texcount -1 -sum -merge -count-all #1.tex > #1-words.sum}%
  \openin\tmp=#1-words.sum%
  \read\tmp to \theword%
  \closein\tmp%
}

